{
    "schemaVersion": 1,
    "distro": {
        "id": "iot-edition",
        "name": "TSIX IoT Edition",
        "version": "0.1.0-draft",
        "status": "draft",
        "description": "Distro TSIX untuk pengembangan dan operasi IoT, dengan Lantana serta seluruh komponen inti TSIX Desktop Environment.",
        "purpose": [
            "Menjalankan aplikasi dan layanan IoT di atas kernel, runtime, dan VFS TSIX.",
            "Menerima, mengelola, dan menampilkan data perangkat melalui Lantana.",
            "Menyediakan sumber firmware TSIX untuk board ESP32 dan ESP8266.",
            "Menyediakan PixelSpace, DOME, Asteracea, Emerald, Cashew, dan Pistachio sebagai TSIX Desktop Environment."
        ],
        "features": [
            "Kernel, runtime, command, shared runtime, library, dan trust anchor TSIX.",
            "Aplikasi Lantana dan dashboard IoT yang dikenali inventaris.",
            "Firmware IoT dan dependensi PlatformIO yang dikenali inventaris.",
            "PixelSpace Protocol serta komponen DOME, Asteracea, Emerald, Cashew, dan Pistachio.",
            "Konfigurasi boot, Tpkg, DOME, dan Asteracea yang dipilih secara eksplisit."
        ]
    },
    "sourceInventory": "../tsix-files.json",
    "outputDirectory": "../iot-edition",
    "layout": "preserve-source-path",
    "installation": {
        "entrypoint": "scripts/install.ts",
        "npmScriptName": "tsix:install",
        "rootAccountBootstrap": "locked-until-password-set"
    },
    "selection": {
        "match": "any",
        "exactPathsOverrideCategoryExclusions": true,
        "include": {
            "categories": ["command", "kernel", "library", "runtime", "shared-runtime", "trust-anchor"],
            "tags": ["iot", "tde"],
            "paths": [
                "LICENSE",
                "package-lock.json",
                "package.json",
                "platformio/TSIX-All-in-One/lib/PubSubClient/LICENSE.txt",
                "platformio/TSIX-All-in-One/platformio.ini",
                "scripts/install.ts",
                "scripts/lib/binary-mode.ts",
                "scripts/lib/fresh-accounts.ts",
                "scripts/lib/fresh-fstab.ts",
                "scripts/lib/text-file.ts",
                "scripts/lib/user-account.ts",
                "src/mirror/opt/eucalyptus/eucalyptus.ts",
                "src/mirror/opt/file-cruiser/file-cruiser.ts",
                "src/mirror/opt/mysqld/mysqld.ts",
                "src/mirror/opt/pixelterm/pixelterm.ts",
                "src/mirror/opt/set-theme/set-theme.ts",
                "src/mirror/opt/taskmgr/taskmgr.ts",
                "src/mirror/opt/tssh/tssh.ts",
                "src/mirror/opt/tssh/tsshd.ts",
                "src/mirror/etc/motd",
                "src/mirror/etc/motd.json",
                "src/mirror/etc/profile",
                "src/mirror/etc/rc.local",
                "src/mirror/etc/tpkg/config.json",
                "src/mirror/etc/tpkg/packages.json",
                "tsconfig.json"
            ]
        },
        "exclude": {
            "categories": [
                "build-config",
                "documentation",
                "inventory",
                "node-local",
                "other",
                "sensitive",
                "test",
                "tooling"
            ],
            "protectedCategories": ["node-local", "sensitive", "test"],
            "classificationStates": ["needs-review"],
            "tags": ["example"],
            "pathPrefixes": [
                "src/mirror/opt/test",
                "src/mirror/etc/asteracea/menu/craving-tracker.menu",
                "src/mirror/etc/asteracea/menu/gui-chat.menu",
                "src/mirror/etc/asteracea/menu/gui-db.menu",
                "src/mirror/etc/asteracea/menu/hello-world.menu",
                "src/mirror/etc/asteracea/menu/image-viewer.menu",
                "src/mirror/etc/asteracea/menu/iot-dashboard.menu",
                "src/mirror/etc/asteracea/menu/lcd-emulator.menu",
                "src/mirror/etc/asteracea/menu/network-traffic.menu",
                "src/mirror/etc/asteracea/menu/pixelspace-traffic.menu",
                "src/mirror/etc/asteracea/menu/retroterm.menu",
                "src/mirror/etc/asteracea/menu/telechat.menu",
                "src/kernel/devices/aux-devices/ILI9341Device.ts",
                "src/kernel/devices/aux-devices/LM6029Device.ts",
                "src/kernel/devices/aux-devices/PLCDDevice.ts",
                "src/kernel/devices/aux-devices/joystick.ts"
            ]
        }
    },
    "releaseNotes": [
        "Manifest ini masih draft; jangan gunakan sebagai image rilis tanpa review dependensi dan konfigurasi node.",
        "Menu Asteracea untuk aplikasi di luar scope tidak disertakan; semua menu yang dikemas telah diaudit terhadap file programnya.",
        "platformio.ini menyertakan upload_port khusus perangkat pengembang dan mungkin perlu penyesuaian untuk board pengguna."
    ]
}
