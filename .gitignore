# ============================================================
# TSIX — .gitignore
# JANGAN commit file yang berisi kredensial / data runtime.
# ============================================================

# --- Database runtime (BERISI HASH PASSWORD & KEY ASLI) ---
# system.db & systembak.db berisi /etc/shadow asli (hash bcrypt root,
# kakang, dll) + key yang di-generate saat boot. JANGAN pernah di-push.
system.db
systembak.db
*.db
*.db-*
*.bak
*.bak-*

# --- Konfigurasi lokal / hasil install (machine-specific) ---
# dibuat oleh `npm run install` (path DB, email creator, dll)
src/sysconfig.json

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- Artifak build / framework ter-generate ---
dist/
build/
src/.tsix_sdk/
.vfs_cache/
*.tsbuildinfo

# --- Artifak test mount (host dir dibuat oleh Syscalls.test.ts) ---
test-mount*

# --- Arsip / file besar yang tidak perlu di-track ---
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.bak.zip

# --- Log ---
*.log
logs/
jsix.log

# --- Environment / secret files (defensive) ---
.env
.env.*
*.pem
*.key
!src/mirror/etc/tpkg/keys/public.pem
*.p12
*.pfx
*.jks

# --- OS / editor ---
.DS_Store

# --- Catatan lokal (bukan bagian repo) ---
# docs/jayalaras-iot = catatan NOS lokal (referensi migrasi), jangan di-commit.
docs/jayalaras-iot/
Thumbs.db
.vscode/
.idea/

# --- Isi home direktori user (file personal) — direktori-nya TETAP di-track ---
# File personal/dev per user (test coba-coba, .sh_history, dll) TIDAK di-commit,
# tapi direktori home dipertahankan via .gitkeep supaya /root, /home, /home/<user>
# tetap hadir di clone fresh (dibutuhkan login/chdir). Installer skip file tanpa
# ekstensi, jadi .gitkeep tidak ikut ter-sync ke VFS.
src/mirror/root/*
!src/mirror/root/.gitkeep
src/mirror/home/*
!src/mirror/home/.gitkeep
!src/mirror/home/kakang/
src/mirror/home/kakang/*
!src/mirror/home/kakang/.gitkeep
**/.sh_history

# --- shared/ — isi personal/dev; KECUALI ekstensi .jpg yang tetap di-track ---
shared/*
!shared/*.jpg
